{
  "name": "slack-food-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Target-agnostic Slack food logging bot",
  "type": "module",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.46",
    "@ai-sdk/mistral": "^4.0.29",
    "@slack/bolt": "5.0.0",
    "ai": "^7.0.69",
    "bullmq": "^6.1.2",
    "ioredis": "^6.0.0",
    "redis": "6.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "^2.9.0"
  }
}
