# Cloudflare Worker secrets: set each deployed value with
# `wrangler secret put <NAME>`; never commit secret values.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Future Upstash Redis configuration. It is not an active Worker runtime dependency.
REDIS_URL=redis://127.0.0.1:6379
TARGET_API_BASE_URL=https://target.example.test
TARGET_API_CLIENT_CREDENTIAL=
AI_PROVIDER=
AI_API_KEY=
# Node HTTP server only. Cloudflare Workers do not use PORT.
PORT=3000
# TELEMETRY_ENVIRONMENT is a non-secret Worker variable in wrangler.jsonc.
TELEMETRY_DSN=
TELEMETRY_ENVIRONMENT=development
