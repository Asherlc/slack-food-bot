# Cloudflare Worker secrets: set each deployed value with `wrangler secret put`;
# never commit production values.
SLACK_CLIENT_ID=local-client-id
SLACK_CLIENT_SECRET=local-client-secret
SLACK_SIGNING_SECRET=local-signing-secret
TARGET_API_BASE_URL=https://target.example.test
TARGET_API_CLIENT_ID=local-target-client-id
TARGET_API_CLIENT_SECRET=local-target-client-secret
BOT_STATE_ENCRYPTION_KEY=replace-with-a-43-character-base64url-key
DEFAULT_TIME_ZONE=America/Los_Angeles
# PUBLIC_BASE_URL=https://slack-food-bot.<account>.workers.dev
GEMINI_API_KEY=
MISTRAL_API_KEY=
# Existing deployments may use AI_PROVIDER=gemini and AI_API_KEY instead.
# TELEMETRY_DSN=https://telemetry.example.test/123
TELEMETRY_ENVIRONMENT=development
