# Render secrets: set each deployed value in the Render dashboard; never commit
# production values.
SLACK_CLIENT_ID=local-client-id
SLACK_CLIENT_SECRET=local-client-secret
SLACK_SIGNING_SECRET=local-signing-secret
SLACK_STATE_SECRET=replace-with-at-least-32-random-characters
REDIS_URL=redis://127.0.0.1:6379
TARGET_API_BASE_URL=https://target.example.test
TARGET_API_CLIENT_CREDENTIAL=local-target-credential
BOT_STATE_ENCRYPTION_KEY=replace-with-a-43-character-base64url-key
PUBLIC_BASE_URL=https://food-bot.example.test
GEMINI_API_KEY=
MISTRAL_API_KEY=
PORT=3000
# TELEMETRY_DSN=https://telemetry.example.test/123
TELEMETRY_ENVIRONMENT=development
