{
  "display_information": {
    "name": "Dofek Food Bot",
    "description": "Capture food from Slack and save it to Dofek after confirmation.",
    "background_color": "#1D4ED8"
  },
  "features": {
    "bot_user": {
      "display_name": "Dofek Food Bot",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/link-dofek",
        "description": "Link your Dofek account",
        "should_escape": false,
        "url": "https://slack-food-bot.slack-food-bot.workers.dev/slack/commands"
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://slack-food-bot.slack-food-bot.workers.dev/slack/oauth_redirect"
    ],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "chat:write",
        "commands",
        "im:history",
        "im:read",
        "im:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://slack-food-bot.slack-food-bot.workers.dev/slack/events",
      "bot_events": ["app_mention", "message.im"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://slack-food-bot.slack-food-bot.workers.dev/slack/actions"
    },
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
